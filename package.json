{
  "name": "pulse-desk",
  "version": "1.0.0",
  "description": "Always-on-desktop finance cockpit: hyped stocks, portfolio P&L, market news sentiment, crypto pumps and weather.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node tools/gen-icons.js",
    "web": "node tools/build-web.js",
    "docs": "node tools/gen-docs.js",
    "prebuild": "node tools/gen-icons.js",
    "build": "electron-builder --win nsis portable"
  },
  "keywords": [
    "finance",
    "portfolio",
    "stocks",
    "crypto",
    "desktop-widget",
    "pwa"
  ],
  "author": "Dheerav Tandon",
  "license": "MIT",
  "devDependencies": {
    "docx": "^9.7.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "exceljs": "^4.4.0"
  },
  "build": {
    "appId": "in.tandsol.pulsedesk",
    "productName": "PulseDesk",
    "copyright": "Created by Dheerav Tandon",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PulseDesk"
    },
    "portable": {
      "artifactName": "PulseDesk-${version}-portable.exe"
    }
  }
}
