{
  "name": "pulse-desk",
  "version": "1.0.0",
  "description": "Always-on-desktop finance cockpit: hyped stocks, portfolio P&L, market news sentiment, crypto pumps and weather.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win nsis portable"
  },
  "keywords": ["finance", "portfolio", "stocks", "crypto", "desktop-widget"],
  "author": "TandSol",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.tandsol.pulsedesk",
    "productName": "PulseDesk",
    "files": ["main.js", "preload.js", "src/**/*", "assets/**/*"],
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
